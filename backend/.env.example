# MahaAtithi Backend — Environment Variables
# ============================================================
# Local use:   cp .env.example .env   then fill in real values.
# Never commit .env (it is git-ignored). Only this example file is tracked.
#
# [REQUIRED] variables make the server refuse to start when missing — enforced by
# requireEnv() in src/config/index.ts. The log then shows a line starting
# "[STARTUP] Missing or invalid required environment variable: NAME".
#
# PRODUCTION (Railway): set these as service variables in the Railway dashboard.
# They are NOT read from this file there. Differences from local development:
#   NODE_ENV  = production      (turns on the production CORS list and HTTPS redirect,
#                                and hides internal error details)
#   PORT      = leave UNSET, or set it to the port the Railway domain forwards to.
#               Railway injects PORT itself. A PORT that differs from the domain's
#               target port makes every request fail with 502 "connection refused".
#   LOG_LEVEL = info
# ============================================================

# ─── App ─────────────────────────────────────────────────────
# development | production
NODE_ENV=development
# Local only. See the production note above.
PORT=3000
# error | warn | info | debug
LOG_LEVEL=info

# ─── Database [REQUIRED] ─────────────────────────────────────
# Local Postgres:
#   postgresql://mahaatithi_admin:CHANGE_ME@localhost:5432/mahaatithi?schema=public
# Supabase through the transaction pooler (port 6543) — keep pgbouncer=true, or Prisma
# fails with "prepared statement already exists":
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
DATABASE_URL="postgresql://mahaatithi_admin:CHANGE_ME@localhost:5432/mahaatithi?schema=public"

# ─── JWT [REQUIRED — min 32 characters] ──────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this in production signs every enumerator out.
JWT_SECRET=REPLACE_WITH_96_CHAR_HEX_FROM_CRYPTO_RANDOMBYTES_48

# Lifetime of the short-lived access token. The mobile app renews it in the
# background before it lapses, so this can stay short.
JWT_ACCESS_EXPIRY=15m

# Sliding lifetime (in DAYS) of a refresh session. Every successful refresh pushes
# the expiry out by this many days again, so an enumerator who opens the app inside
# the window stays signed in.
SESSION_EXPIRY_DAYS=365

# ─── Upstash Redis REST [REQUIRED] ───────────────────────────
# Per-account brute-force lockout. Create a free database at https://upstash.com
# and copy the REST URL and token.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME_UPSTASH_TOKEN

# ─── AWS S3 [REQUIRED] ───────────────────────────────────────
# All photo and document uploads. If these are blank or wrong the server refuses to
# start, rather than failing later on the first media upload.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=mahaatithi-media

# Optional. S3-compatible store (local MinIO):
# S3_ENDPOINT=http://localhost:9000
# Optional. Base URL for the permanent media links written into SQL/CSV exports, for
# example a CloudFront domain. Without it the URL is built from the bucket and region,
# and only works if the bucket policy allows public read on the exported prefix.
# S3_PUBLIC_BASE_URL=https://media.example.com

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# ─── Survey review ───────────────────────────────────────────
# A completed survey whose GPS is farther than this many km from the business is
# flagged for an admin to review. It is still accepted. Default 5.
GPS_FLAG_DISTANCE_KM=5

# ─── Misc ────────────────────────────────────────────────────
CSV_BATCH_SIZE=1000

# ─── Docker Compose only ─────────────────────────────────────
# Read by the root docker-compose.yml for the local Postgres container. Not used by
# the API itself, and not needed on Railway.
POSTGRES_PASSWORD=CHANGE_ME
